#!/usr/bin/env bash
# Thin shim. The implementation lives in mimikun/mimikun.scripts as vup.sh,
# which is what actually gets run; this file used to be a second, diverging
# copy of it. See that repo's AGENTS.md.
#
# The copy that lived here had drifted badly by the time it was retired:
#   - it parsed `cargo install-update -l` with `grep Yes | cut -d " " -f 1`,
#     the parse src/lib/cargo.ts exists to replace, and skipped only tabiew
#     where the list is now tabiew and rustowl
#   - it ran `fish -c 'fisher update'`, and fisher is not installed -- pez is
#   - it gated the work-PC branch on `[ "$(hostname)" = ... ]`, and there is
#     no hostname command here, so that branch could never be taken
#   - it kept use_pueue() and no_pueue() as two hand-maintained copies of the
#     same update list, which is where the cargo drift came from
set -euo pipefail

SCRIPTS_DIR="${MIMIKUN_SCRIPTS_DIR:-$HOME/scripts}"
if [[ ! -d "$SCRIPTS_DIR" ]]; then
  echo "mimikun.scripts not found at $SCRIPTS_DIR" >&2
  echo "clone it, or set MIMIKUN_SCRIPTS_DIR" >&2
  exit 1
fi

exec bash "$SCRIPTS_DIR/vup.sh" "$@"
